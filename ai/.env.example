PORT=5000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Scheduler
CRON_SCHEDULE=0 2 * * *
CRON_TIMEZONE=Asia/Kolkata
RUN_STARTUP_SYNC=true

# AGMARKNET API
AGMARKNET_BASE_URL=https://api.agmarknet.gov.in/v1/dashboard-data/
REQUEST_TIMEOUT_MS=15000
AGMARKNET_DASHBOARD=marketwise_price_arrival
AGMARKNET_GROUP=[3]
AGMARKNET_COMMODITY=[100001]
AGMARKNET_VARIETY=100021
AGMARKNET_STATE=100006
AGMARKNET_DISTRICT=[100007]
AGMARKNET_MARKET=[100009]
AGMARKNET_GRADES=[4]
AGMARKNET_LIMIT=10
AGMARKNET_FORMAT=json
